# =====================================================================
# 前端环境变量模板（复制为 .env / .env.development / .env.production 使用）
#
# 加载规则（Vite）：
#   - .env              所有模式都会加载（只放非敏感、跨模式公共项）
#   - .env.development  vite dev 时加载（MODE=development）
#   - .env.production   vite build 时加载（MODE=production）
#   - .env.staging      vite build --mode staging 时加载
#   后加载的模式文件会覆盖 .env 中的同名变量。
#
# 隔离要点（issue #1028）：
#   不要把 Supabase 等环境相关 / 敏感变量放进 .env（会被所有模式共享）。
#   Supabase 凭证按模式分别放在 .env.development（开发，建议独立的 dev 项目）
#   与 .env.production（生产，权威，已入库）。否则生产构建会静默复用开发凭证，
#   导致开发/测试的注册登录写入生产用户表，污染线上数据。
# =====================================================================

# ---- 公共（放 .env）----
VITE_PORT=8848
VITE_HIDE_HOME=false

# ---- 开发（放 .env.development，该文件应被 .gitignore 忽略，勿入库）----
# VITE_APP_ENV 用于前端区分 Server 端与 Product 端
VITE_APP_ENV=development
VITE_PUBLIC_PATH=/
VITE_ROUTER_HISTORY="hash"
VITE_CDN=false
# 替换为独立 dev Supabase 项目（免费层，约 2 分钟，0 成本）。跟踪 issue #1028。
# 注意：这里只能用 dev 项目的 URL/anon key，禁止填生产项目值，否则开发注册会写入生产用户表。
VITE_SUPABASE_URL=https://<dev-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<dev-anon-key>

# ---- 生产（放 .env.production，已入库，勿在此贴真实值）----
# VITE_APP_ENV=production
# VITE_PUBLIC_PATH=/
# VITE_ROUTER_HISTORY="hash"
# VITE_CDN=false
# VITE_COMPRESSION="none"
# VITE_SUPABASE_URL=https://<prod-project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<prod-anon-key>
