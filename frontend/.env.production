# 线上环境配置（vite build 自动加载，对应 MODE=production）

# 当前环境标识
VITE_APP_ENV=production

#线上环境平台打包路径
VITE_PUBLIC_PATH = /
#线上环境路由历史模式
VITE_ROUTER_HISTORY = "hash"
# 是否在打包时使用cdn替换本地库
VITE_CDN = false
# 是否启用gzip压缩
VITE_COMPRESSION = "none"

# ===== Supabase 配置（生产环境，权威）=====
