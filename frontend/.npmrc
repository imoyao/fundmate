# pnpm 配置 - 适用于 EdgeOne 构建环境

# 启用 pre/post 脚本（允许安装依赖时执行必要的构建脚本）
enable-pre-post-scripts=true

# 严格模式下跳过对等依赖检查（避免部分包安装失败）
strict-peer-dependencies=false

# 提升所有依赖到根 node_modules（兼容某些旧包）
public-hoist-pattern[]=*

# 允许这些依赖执行安装后脚本（非交互式环境）
only-built-dependencies[]=@parcel/watcher
only-built-dependencies[]=esbuild
only-built-dependencies[]=vue-demi
only-built-dependencies[]=core-js
only-built-dependencies[]=es5-ext
