# DB
DATABASE_URL=sqlite:////tmp/dev.db
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
MYSQL_HOST=
MYSQL_PORT=3306

# log
LOG_LEVEL=debug
LOG_PATH=/var/log/
LOG_NAME=app.log

# openAPI
# see also:[OpenAPI Generating - APIFlask](https://apiflask.com/openapi/)
LOCAL_SPEC_PATH=openapi.json
SPEC_FORMAT=json
SYNC_LOCAL_SPEC=True

# mail
MAIL_SERVER=''
MAIL_USERNAME=''
MAIL_PASSWORD=''

# 网站相关
SITE_NAME = '基伴'

# 部署相关
GUNICORN_WORKERS=1
SECRET_KEY=not-so-secret
# In production, set to a higher number, like 31556926
SEND_FILE_MAX_AGE_DEFAULT=31556926

# 理财通数据导出时使用
TENCENTWM_G_TK = ''
TENCENTWM_QLS_KEY = ''
TENCENTWM_QLUIN = ''
