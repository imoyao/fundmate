# =====================================================================
# fundmate 后端环境变量模板（无密钥，提交进库）
#
# 用法：本地首次运行 `cp .env.example .env`，按需取消注释并填值。
# 加载：app/main.py 用 python-dotenv 的 load_dotenv() 读取本文件；
#       真实进程环境变量（shell / docker-compose / 平台注入）优先于本文件。
#
# 环境切换：由 APP_ENV 驱动（见下方）；多环境不需要多套文件，
#           改 APP_ENV + 对应 *_DATABASE_URL 即可。
# 完整权威说明见 docs/dev/db-data-domain.md（第 9 节）。
# =====================================================================

# ===== 基础 =====
# CORS：生产请改成具体前端地址（逗号分隔），不要留 *。
CORS_ORIGINS=http://localhost:8848
# 仅控制 Flask 调试器，不再兼作环境开关（环境开关用 APP_ENV）。
FLASK_DEBUG=1

# ===== 本地缓存（app/core/cache.py）=====
# 文件缓存的落盘目录。CacheService 与温度计 fetchers 共用**同一个**解析入口
# （app/core/cache.py::resolve_cache_file_dir），改这里两套一起生效。
# 缺省为系统临时目录下的 fundmate_cache；容器 / CI / 多实例需要持久化或隔离时才设。
# 温度计的三处子目录（baostock_pb / em_industry_hist / fundfof_crowding）也挂在它下面，
# 经 resolve_cache_subdir() 派生——同样随本变量一起生效（#1539）。
# CACHE_FILE_DIR=/var/cache/fundmate
# 缓存后端：local（默认，进程内 LRU + 文件）/ redis（需装 redis，单机无意义）。
# CACHE_BACKEND=local

# ===== 文件日志（app/core/logging_config.py，#1551）=====
# 批跑（本机常驻调度 / `pdm run sync`）出问题时，CMD 窗口一关就没了现场，
# 故在 stderr 之外同时落盘。默认即可用，以下四项按需覆盖：
#   LOG_DIR             日志目录，默认 backend/logs（相对路径按 cwd 解析）
#   LOG_LEVEL           文件 sink 级别，默认 DEBUG（要看 HTTP/重试细节就别抬到 INFO）
#   LOG_RETENTION_DAYS  保留天数，默认 7
#   LOG_ENABLED         置 0/false 关闭文件日志（CI 或临时排查用）
# 轮转固定为每日 00:00，产物 fundmate_YYYY-MM-DD.log（旧文件自动压成 .zip）。
# 注意：pytest 进程里**默认不落盘**（避免测试噪音写进仓库并霸占 7 天保留窗口），
# 需要在测试里验证落盘时显式置 LOG_ENABLED=1。
# 多进程注意（dev server + scheduler-daemon 同时写）见 docs/dev/scheduler-tasks.md。
# LOG_DIR=/var/log/fundmate
# LOG_LEVEL=DEBUG
# LOG_RETENTION_DAYS=7
# LOG_ENABLED=1

# ===== 运行环境 APP_ENV（驱动数据库自动切换）=====
#   development -> 本地 SQLite（零云依赖，测试最快）
#   staging     -> STAGING_DATABASE_URL（回退 DATABASE_URL）
#   production  -> TURSO_DATABASE_URL（市场域运行库），回退 DATABASE_URL
# 缺省为 production（安全侧）。FLASK_DEBUG 不再混用作环境开关。
APP_ENV=development

# =====================================================================
# 数据库：两个数据域，各自独立一套变量（互不干扰）
#   - 应用运行库 / 市场域：行情、净值、温度计、自选种子等（非敏感）
#   - 用户核心账本库：家庭、用户、持仓、交易（敏感，云端权威）
# 配一个域 = 单库模式；两个域都配 = 双库分离。不配则自动回退本地 SQLite。
# =====================================================================

# ----- 应用运行库（市场域）-----
# development 缺省即本地 SQLite（invest.db），无需配置；如需覆盖：
DEV_DATABASE_URL=sqlite:///./invest.db
# staging（可选）：
# STAGING_DATABASE_URL=sqlite:///./invest.staging.db
# production 运行库（Turso libSQL；填了就走云端，否则回退 DATABASE_URL）：
# TURSO_DATABASE_URL=libsql://<db>-<org>.aws-<region>.turso.io?authToken=<token>
#   直连端点，由 `turso db show <db> --url` 获取；勿用平台端点 https://<org>-<db>.turso.io/，
#   后者会 308 重定向而 Hrana/libSQL 客户端不跟随，生产连接失败（见 #1525）。
# 通用回退（prod/staging 未设上面专用变量时生效；多个旧脚本只认它）：
DATABASE_URL=sqlite:///./invest.db

# ----- 用户核心账本库（user 域）-----
# 仅当已接入 Supabase 云端时填写；留空则用户数据自动回退本地 SQLite：
#   development 下**默认与 market 同库**（即同一个 invest.db，单库模式），
#   只有显式配下面的 DEV_USER_DATABASE_URL 才拆出独立文件（双库模拟）。
# SUPABASE_DATABASE_URL=postgresql://postgres:[PASSWORD]@<project>.supabase.co:5432/postgres
# development 下 user 域本地回退文件（不设 SUPABASE 时生效）：
# DEV_USER_DATABASE_URL=sqlite:///./invest.user.dev.db
# production/staging 下 user 域本地回退（极少用，prod 应配 Supabase）：
# USER_DATABASE_URL=sqlite:///./invest.user.db

# =====================================================================
# 第三方 API（按需填写，与本机抓取/解析相关；非数据库必选项）
# =====================================================================
# 东方财富 / 基金数据（akshare 走公开接口，无需 key，但需国内 IP 出口）
# TUSHARE_TOKEN=xxxx
# 且慢基金数据
# QIEMAN_API_KEY=xxxx
# 火山 Ark 结构化解析（OCR / 智能识别）
# ARK_API_KEY=xxxx
# ARK_MODEL=doubao-seed-2-0-mini-260428

# ----- 集思录（可转债：YTM / 剩余年限 / 正股PB / 双低 需登录态）-----
# 取法：浏览器登录 jisilu.cn（勾选「记住我」）→ F12 → Network → 点任意 jisilu.cn
#       请求 → 复制 Request Headers 里的**整行 cookie**（含 kbzw__user_login）→ 粘到
#       下面（单行、勿换行；值含 `#` 时用引号包住）。
# 有效期：kbzw__user_login 为长效 token，但在同账号重新登录/退登时会被轮换失效。
# 自检：pdm run scheduler --check-jsl  或  pdm run python -m scripts.check_jsl_cookie
#       （退出码 2 = 已失效，需重新复制）
# JSL_COOKIE=kbzw__Session=xxx; kbzw__user_login=yyy

# ----- 定时任务随机抖动（#1400 抓取礼仪）-----
# 外部 cron 只能触发固定时刻（如每天 00:00），scheduler 会在开工前于 0~该值 秒内
# 随机延迟，避免"每天同一秒准点抓取"被数据源识别。默认 600（10 分钟），0 = 关闭。
# 本机进程内调度（见下节）复用同一开关。
# SYNC_JITTER_SECONDS=600
# 同步前 JSL 保活与同步之间的随机间隔上限（秒）
# SYNC_JOB_GAP_SECONDS=5

# =====================================================================
# 本机每日数据抓取调度（#1467）
#   背景：外部触发（CI daily-snapshot / 系统 cron）在本机默认不生效，本地库会
#         长期停更（实测净值止于 2026-08-14）。打开下面的开关后，**应用启动即
#         在进程内按 cron 更新**，不需要任何外部定时器。
#   二选一：应用内调度（本开关）或独立守护进程 `pdm run scheduler-daemon`；
#           同机靠 data/daily_scheduler.lock 保证只有一个生效。
#   查状态：pdm run invoke sched.status
#   注意：CI / pytest 进程内一律不启动（无需在 CI 里关它）。
# =====================================================================

# 总开关：1/true 开启（本机开发建议开）。
SCHEDULER_ENABLED=1
# 调度时区（cron 按此时区解释）
# SCHEDULER_TIMEZONE=Asia/Shanghai

# ----- 每日任务与触发时刻（北京时间）-----
# 完整清单与代码同源：app/services/daily_scheduler.py 的 _JOB_TEMPLATES。
# 守卫 scripts/guard_scheduler_env_example.py 断言「每个进每日调度的 job 在此都有开关」，
# 漏写即 CI 红——本段曾因此漏掉 7 个 job（含 core 的 price_history），见 #1186。
# ⚠️ 变量名不总是带 job 名：env 后缀按「数据是什么」起名，个别 job 对不上
# （`fund_position` ↔ SCHEDULER_FUND_HOLDING_*、`temperature` 无后缀）。
# 按 job 名搜不到时，去 _JOB_TEMPLATES 看它绑的环境变量常量。
#
# 收盘估值定格（#2141）：工作日 15:15 / 19:15 / 21:15 三时点，
# 供收益日历「今日预估」回退；源端净值公布后即清空估值，晚点无意义。
# 星期写 mon-fri（APScheduler 的 day_of_week 0=周一，* * 1-5 会排成周二~周六）
# SCHEDULER_VALUATION_ENABLED=true
# SCHEDULER_VALUATION_CRON=15 15,19,21 * * mon-fri
# 探市大类资产日频快照（#1460）：overview「读库优先」的库源；纯本地不联网。
# SCHEDULER_MARKET_ASSET_DAILY_ENABLED=true
# SCHEDULER_MARKET_ASSET_DAILY_CRON=10 17 * * *
# 场内日线（#1104）：股票 / ETF / 可转债每日 OHLC 落 price_history，按「库内最新交易日
# 的次日」缺口回补（漏跑可自愈）。A 股 15:00 收盘、盘后发布；ETF 当日 K 线常次日才齐，
# 由下一次运行补齐。**必须早于持仓现价回写**——后者读的就是这里落库的收盘价。
# SCHEDULER_PRICE_HISTORY_ENABLED=true
# SCHEDULER_PRICE_HISTORY_CRON=30 17 * * *
# 指数日线（#275 / #861）：万得系（韭圈儿）+ 交易所宽基（沪深300 等，腾讯直连）
# + 中证专属码（中证指数官网）。目标池是固定清单，与持仓/自选无关。
# SCHEDULER_INDEX_DAILY_ENABLED=true
# SCHEDULER_INDEX_DAILY_CRON=0 18 * * *
# 指数估值 PE / 股息率（#1397）：中证官方约收盘后 1 小时下发，排在 index_daily 之后
# 拉当日日线再取同日估值，避免「昨日日线 + 今日估值」的错配口径。
# SCHEDULER_INDEX_VALUATION_ENABLED=true
# SCHEDULER_INDEX_VALUATION_CRON=20 18 * * *
# 温度计：集思录中位 PB / 韭圈儿 / 行业拥挤度盘后即出
# SCHEDULER_TEMPERATURE_ENABLED=true
# SCHEDULER_TEMPERATURE_CRON=0 20 * * *
# 可转债条款 + 集思录强赎计数（#1393 的列依赖它）：集思录收盘后更新，
# 排在 fund_nav 之前，让「强赎计数」与当日净值同晚就绪。
# SCHEDULER_CONVERTIBLE_BOND_ENABLED=true
# SCHEDULER_CONVERTIBLE_BOND_CRON=0 21 * * *
# 自选 + 持仓的基金净值（场外净值 19:00~24:00 陆续公布）
# SCHEDULER_NAV_ENABLED=true
# SCHEDULER_NAV_CRON=30 21 * * *
# 分红 / 送股事件（#1179）：公告类，增量为主（按 import_hash 幂等去重），
# 排在 fund_nav 之后错峰。
# SCHEDULER_DIVIDEND_SPLIT_ENABLED=true
# SCHEDULER_DIVIDEND_SPLIT_CRON=45 21 * * *
# 预估→正式对照（#2142）：官方净值到位后翻 confirmed + 记偏差。
# 晚 22:30 对照当晚 21:30 fund_nav 落库的昨日净值；晨 08:30 兜底（休市 catch-up）。
# 进 REST_DAY_JOB_NAMES：周末 fund_nav 补昨日净值后，周六晨间即可对照周五预估。
# SCHEDULER_VALUATION_RECONCILE_ENABLED=true
# SCHEDULER_VALUATION_RECONCILE_CRON=30 8,22 * * *
# 净值缺失流水回填：pending_nav 流水在官方净值到位后重算份额/成本并清标记。
# 与对照同吃 T-1 落库节奏，排在对照之后 5 分钟；晨 08:35 兜底。纯 DB 零外部请求。
# SCHEDULER_NAV_BACKFILL_ENABLED=true
# SCHEDULER_NAV_BACKFILL_CRON=35 8,22 * * *
# 投顾组合持仓/调仓快照（净值之后；且慢无历史调仓接口，快照序列是唯一来源）
# SCHEDULER_ADVISOR_ENABLED=true
# SCHEDULER_ADVISOR_CRON=0 22 * * *
# 持仓现价回写（#1104）：把已确认净值写回 positions.current_price，否则盈亏恒为 0。
# **必须晚于净值同步**（NAV_CRON），它读的就是后者刚落库的净值；与投顾错开 15 分钟
# SCHEDULER_POSITION_PRICE_ENABLED=true
# SCHEDULER_POSITION_PRICE_CRON=15 22 * * *
# 基金持仓明细 + 行业配置（#870 / #1983）：季报口径，**每周一次**（周一 23:00）。
# 持仓日变更量恒为 0，每日跑纯属浪费外部请求并叠加东财限流风险。
# 星期写 mon（APScheduler 的 day_of_week 0=周一，写数字 1 会排成周二）
# SCHEDULER_FUND_HOLDING_ENABLED=true
# SCHEDULER_FUND_HOLDING_CRON=0 23 * * mon
# 基金投资风格箱（#2478）：晨星式 8 分类月度全历史，目标池限量 500。**每月 2 日 22:30**。
# 上游按「月」出数，每日跑只会重复打外部请求；错开季报持仓（周一 23:00）。
# SCHEDULER_FUND_STYLE_ENABLED=true
# SCHEDULER_FUND_STYLE_CRON=30 22 2 * *
# 行业 PB-ROE 散点（#2481）：韭圈儿 pbroe-sg2 一次取全行业矩阵，复用 market_composites
# 一日一快照（删旧写新）。错开 index_valuation（18:20）与 temperature（20:00）。
# SCHEDULER_INDUSTRY_PBROE_ENABLED=true
# SCHEDULER_INDUSTRY_PBROE_CRON=40 18 * * *
# 孤儿交易回填（#950）：扫 position_id IS NULL 的流水，按 symbol 身份挂回既有持仓。
# 纯本地查库、不联网，幂等；排在当日最后一个落库类 job 之后，看到的是当天最终状态。
# SCHEDULER_ORPHAN_BACKFILL_ENABLED=true
# SCHEDULER_ORPHAN_BACKFILL_CRON=30 23 * * *
# 资产快照落账（#2132 / D63）：家庭/账户当日账面值，纯本地零外部请求、幂等 upsert。
# 必须晚于当日所有落库类 job（净值 21:30 / 现价 22:15 / 回填 22:35 / 孤儿 23:30），
# 且不能跨零点（否则 snapshot_date 变成次日、标签日错位）。休市日照跑（补日历连续性）。
# SCHEDULER_ASSET_SNAPSHOT_ENABLED=true
# SCHEDULER_ASSET_SNAPSHOT_CRON=45 23 * * *

# ----- 行为开关 -----
# 周末 / 法定节假日 / 调休补班周末不抓（非开盘日无新数据，空跑只会留失败审计）
# SCHEDULER_SKIP_NON_TRADING_DAY=true
# 应用启动后补跑「当天已过触发时刻却还没成功」的任务（错过开机时间也能补上）
# SCHEDULER_RUN_ON_START=true
# 启动补跑的延迟秒数（给应用启动让路）
# SCHEDULER_STARTUP_DELAY_SECONDS=180
