# =====================================================================
# fundmate 后端环境变量模板（无密钥，提交进库）
#
# 用法：本地首次运行 `cp .env.example .env`，按需取消注释并填值。
# 加载：app/main.py 用 python-dotenv 的 load_dotenv() 读取本文件；
#       真实进程环境变量（shell / docker-compose / 平台注入）优先于本文件。
#
# 环境切换：由 APP_ENV 驱动（见下方）；多环境不需要多套文件，
#           改 APP_ENV + 对应 *_DATABASE_URL 即可。
# 完整权威说明见 docs/dev/db-data-domain.md（第 9 节）。
# =====================================================================

# ===== 基础 =====
# CORS：生产请改成具体前端地址（逗号分隔），不要留 *。
CORS_ORIGINS=http://localhost:8848
# 仅控制 Flask 调试器，不再兼作环境开关（环境开关用 APP_ENV）。
FLASK_DEBUG=1

# ===== 运行环境 APP_ENV（驱动数据库自动切换）=====
#   development -> 本地 SQLite（零云依赖，测试最快）
#   staging     -> STAGING_DATABASE_URL（回退 DATABASE_URL）
#   production  -> TURSO_DATABASE_URL（市场域运行库），回退 DATABASE_URL
# 缺省为 production（安全侧）。FLASK_DEBUG 不再混用作环境开关。
APP_ENV=development

# =====================================================================
# 数据库：两个数据域，各自独立一套变量（互不干扰）
#   - 应用运行库 / 市场域：行情、净值、温度计、自选种子等（非敏感）
#   - 用户核心账本库：家庭、用户、持仓、交易（敏感，云端权威）
# 配一个域 = 单库模式；两个域都配 = 双库分离。不配则自动回退本地 SQLite。
# =====================================================================

# ----- 应用运行库（市场域）-----
# development 缺省即本地 SQLite（invest.db），无需配置；如需覆盖：
DEV_DATABASE_URL=sqlite:///./invest.db
# staging（可选）：
# STAGING_DATABASE_URL=sqlite:///./invest.staging.db
# production 运行库（Turso libSQL；填了就走云端，否则回退 DATABASE_URL）：
# TURSO_DATABASE_URL=https://<org>-<db>.turso.io/?authToken=<token>
# 通用回退（prod/staging 未设上面专用变量时生效；多个旧脚本只认它）：
DATABASE_URL=sqlite:///./invest.db

# ----- 用户核心账本库（user 域）-----
# 仅当已接入 Supabase 云端时填写；留空则用户数据自动回退本地 SQLite：
#   development 下**默认与 market 同库**（即同一个 invest.db，单库模式），
#   只有显式配下面的 DEV_USER_DATABASE_URL 才拆出独立文件（双库模拟）。
# SUPABASE_DATABASE_URL=postgresql://postgres:[PASSWORD]@<project>.supabase.co:5432/postgres
# development 下 user 域本地回退文件（不设 SUPABASE 时生效）：
# DEV_USER_DATABASE_URL=sqlite:///./invest.user.dev.db
# production/staging 下 user 域本地回退（极少用，prod 应配 Supabase）：
# USER_DATABASE_URL=sqlite:///./invest.user.db

# =====================================================================
# 第三方 API（按需填写，与本机抓取/解析相关；非数据库必选项）
# =====================================================================
# 东方财富 / 基金数据（akshare 走公开接口，无需 key，但需国内 IP 出口）
# TUSHARE_TOKEN=xxxx
# 且慢基金数据
# QIEMAN_API_KEY=xxxx
# 火山 Ark 结构化解析（OCR / 智能识别）
# ARK_API_KEY=xxxx
# ARK_MODEL=doubao-seed-2-0-mini-260428

# ----- 集思录（可转债：YTM / 剩余年限 / 正股PB / 双低 需登录态）-----
# 取法：浏览器登录 jisilu.cn（勾选「记住我」）→ F12 → Network → 点任意 jisilu.cn
#       请求 → 复制 Request Headers 里的**整行 cookie**（含 kbzw__user_login）→ 粘到
#       下面（单行、勿换行；值含 `#` 时用引号包住）。
# 有效期：kbzw__user_login 为长效 token，但在同账号重新登录/退登时会被轮换失效。
# 自检：pdm run scheduler --check-jsl  或  pdm run python -m scripts.check_jsl_cookie
#       （退出码 2 = 已失效，需重新复制）
# JSL_COOKIE=kbzw__Session=xxx; kbzw__user_login=yyy

# ----- 定时任务随机抖动（#1400 抓取礼仪）-----
# 外部 cron 只能触发固定时刻（如每天 00:00），scheduler 会在开工前于 0~该值 秒内
# 随机延迟，避免"每天同一秒准点抓取"被数据源识别。默认 600（10 分钟），0 = 关闭。
# SYNC_JITTER_SECONDS=600
# 同步前 JSL 保活与同步之间的随机间隔上限（秒）
# SYNC_JOB_GAP_SECONDS=5
