# ===== 基础 =====
# CORS_ORIGINS 默认已收紧为 http://localhost:8848（前端 dev 地址）；生产请指定具体前端地址，逗号分隔
CORS_ORIGINS=http://localhost:8848
FLASK_DEBUG=1

# ===== 运行环境（issue #1028 方案 B）=====
# APP_ENV 驱动后端数据库自动切换，与前端 VITE_APP_ENV 对齐：
#   development -> 本地 SQLite 运行库（invest.dev.db），零云依赖
#   staging     -> STAGING_DATABASE_URL（回退 DATABASE_URL）
#   production  -> TURSO_DATABASE_URL（运行库，市场域/非敏感数据），回退 DATABASE_URL
# 注意：FLASK_DEBUG 仅控制调试器，不再混用作环境开关。缺省为 production（安全侧）。
APP_ENV=development

# ===== 应用运行库（市场域/非敏感数据：净值、指数、温度计、自选种子等）=====
# 开发缺省为本地 SQLite，无需配置；如需覆盖：
# DEV_DATABASE_URL=sqlite:///./invest.dev.db
# 生产运行库（Turso）：填 libsql/https URL
# TURSO_DATABASE_URL=https://<org>-<db>.turso.io/?authToken=<token>
DATABASE_URL=sqlite:///./invest.db

# ===== 用户核心账本库（Supabase，独立权威库，与运行库各自独立；D3）=====
# 仅当已接入 Supabase 云端时填写；留空则用户数据暂存应用库（兼容既有单库模式）。
# 后续 Neon 灾备同步在此库基础上扩展，延后（见 #894）。
# SUPABASE_DATABASE_URL=postgresql://postgres:[PASSWORD]@<project>.supabase.co:5432/postgres
