# 极谷跨 project 迁移脚本环境变量模板
# 复制为 .env 后填入真实值（.env 已被 gitignore 忽略，切勿提交）
# 两个 service_role key 拥有绕过 RLS 的完全权限，严禁进仓库 / 前端。

# 旧站 jigu.masantu.com 的 Supabase project（只读源）
OLD_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
OLD_SUPABASE_SERVICE_ROLE_KEY=旧_project的service_role_key

# 主站 Supabase project（app / jigu.duoduobei.com 共用，写入目标）
NEW_SUPABASE_URL=https://yyyyyyyyyyyy.supabase.co
NEW_SUPABASE_SERVICE_ROLE_KEY=主project的service_role_key

# 默认 DRY-RUN；设 true 或传 --apply 才真实写入
APPLY=false
